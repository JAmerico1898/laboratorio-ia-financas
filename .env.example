# ---------------------------------------------------------------------------
# Comitê de Crédito IA — modelo de credenciais (versionado)
#
# Copie para .env.local e preencha entre as aspas. NÃO ponha valores reais aqui.
# Preencha entre as aspas. As mesmas variáveis precisam ser recriadas na
# Vercel (Settings > Environment Variables), sem o prefixo NEXT_PUBLIC_.
#
# Um teste da §10.6 falha se qualquer uma destas aparecer em código de
# cliente, e o hook de pre-commit da §12 aborta o commit no mesmo caso.
# ---------------------------------------------------------------------------

# --- Chaves dos fornecedores (servidor apenas) -----------------------------
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Identificadores de modelo (§3.2) --------------------------------------
# Os IDs Anthropic são completos como estão: NÃO acrescente sufixo de data.
MODEL_SUPERVISOR="claude-sonnet-5"
MODEL_ESPECIALISTA="claude-sonnet-5"

# Confirmado na Models API em 2026-09-02: a família 5.6 tem luna, sol e terra.
# Preço de luna: US$ 0,20 entrada / US$ 1,20 saída por 1M (developers.openai.com/api/docs/pricing).
MODEL_CONTRARIAN="gpt-5.6-luna"

# --- Armazém de execução (§8.2) --------------------------------------------
# Redis efêmero, TTL de 2h. Deixe as duas vazias para usar o adaptador em
# memória — é o que a Fase 1 usa em desenvolvimento e nos testes.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Limites de uso (§8.6) -------------------------------------------------
LIMITE_EXECUCOES_POR_IP_HORA="5"
TETO_CUSTO_MENSAL_USD="50"
